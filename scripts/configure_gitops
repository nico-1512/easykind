#!/bin/bash
set -euo pipefail

source_common () {
  source "$(dirname "${BASH_SOURCE[0]}")/common"
}

_gitops_base64 () {
  printf '%s' "$1" | base64 | tr -d '\n'
}

apply_gitops_repository_secret () {
  local context="$1"
  local repo_name="$2"
  local repo_url="$3"
  local auth_type="$4"
  local username="${5:-}"
  local password="${6:-}"
  local ssh_private_key="${7:-}"
  local secret_data

  secret_data="data:
  type: $(_gitops_base64 git)
  url: $(_gitops_base64 "$repo_url")"

  case "$auth_type" in
    https)
      secret_data+="
  username: $(_gitops_base64 "$username")
  password: $(_gitops_base64 "$password")"
      ;;
    ssh)
      secret_data+="
  sshPrivateKey: $(_gitops_base64 "$ssh_private_key")"
      ;;
  esac

  kubectl --context "$context" -n argocd apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: ${repo_name}
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
${secret_data}
EOF
}

configure_gitops () {
  local cluster_name context repo_url branch branch_input repo_name path_input app_path
  local auth_method="" auth_type="" username="" password="" ssh_key_path="" ssh_private_key=""
  local app_name app_namespace repo_app_base

  if ! command -v gum >/dev/null 2>&1; then
    log_error "gum is required but not installed. Run bootstrap.sh first."
    return 1
  fi

  cluster_name=$(request_user_input "Enter the kind cluster name: ")

  if ! kind get clusters 2>/dev/null | grep -qx "$cluster_name"; then
    log_error "Kind cluster '${cluster_name}' not found"
    return 1
  fi

  context="kind-${cluster_name}"

  if ! kubectl --context "$context" -n argocd get deployment argocd-server >/dev/null 2>&1; then
    log_error "Argo CD is not installed in cluster '${cluster_name}'. Run 'Install Argo CD' first."
    return 1
  fi

  log_info "Use Argo CD for workloads and post-bootstrap add-ons."
  log_info "Choose a path in the repository; press Enter to use the repository root (.)."
  log_info "Keep kind, Calico, kube-vip bootstrap, Argo CD, etcd tools, upgrades and restore in EasyKind."

  repo_url="${GITOPS_REPO_URL:-}"
  if [[ -z "$repo_url" ]]; then
    repo_url=$(request_user_input "Enter the Git repository URL: ")
  else
    log_info "Using Git repository URL from GITOPS_REPO_URL"
  fi
  repo_url="${repo_url%/}"

  branch="${GITOPS_REPO_BRANCH:-main}"
  read -p "Git branch [${branch}]: " branch_input
  branch="${branch_input:-$branch}"

  auth_method="$(gum choose --height 10 --header "Repository authentication" \
    "Public repository (no credentials)" \
    "Private HTTPS (username + token)" \
    "Private SSH (private key)" || true)"

  case "$auth_method" in
    "Public repository (no credentials)")
      auth_type="public"
      ;;
    "Private HTTPS (username + token)")
      auth_type="https"
      username=$(request_user_input "Git username: ")
      while [[ -z "$password" ]]; do
        read -rsp "Git token or password: " password
        printf '\n'
        if [[ -z "$password" ]]; then
          log_error "Token or password cannot be empty"
        fi
      done
      ;;
    "Private SSH (private key)")
      auth_type="ssh"
      if [[ "$repo_url" != git@* && "$repo_url" != ssh://* ]]; then
        log_warning "SSH authentication usually requires an SSH URL such as git@github.com:owner/repo.git"
      fi
      ssh_key_path=$(request_user_input "Path to SSH private key: ")
      if [[ ! -r "$ssh_key_path" ]]; then
        log_error "SSH private key '${ssh_key_path}' is not readable"
        return 1
      fi
      ssh_private_key=$(<"$ssh_key_path")
      log_info "For GitHub/GitLab, Argo CD already trusts the SSH host keys."
      log_info "For a self-hosted Git server, add its host key to argocd-ssh-known-hosts-cm."
      ;;
    *)
      log_info "No authentication method selected"
      return 0
      ;;
  esac

  path_input="${GITOPS_REPO_PATH:-}"
  if [[ -z "$path_input" ]]; then
    read -p "Path within the repository [.]: " path_input
  else
    log_info "Using repository path from GITOPS_REPO_PATH"
  fi
  app_path="${path_input:-.}"
  app_path="${app_path#/}"
  app_path="${app_path%/}"
  app_path="${app_path:-.}"

  if [[ "$app_path" == *".."* ]]; then
    log_error "Repository path must not contain '..'"
    return 1
  fi

  repo_app_base="$(basename "$repo_url" .git)"
  if [[ "$app_path" == "." ]]; then
    app_name="$repo_app_base"
  else
    app_name="${repo_app_base}-$(basename "$app_path")"
  fi
  app_name="$(printf '%s' "$app_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '-' | sed 's/^-*//; s/-*$//')"
  if [[ -z "$app_name" ]]; then
    app_name="gitops-app"
  fi
  app_namespace="default"

  repo_name="repo-$(basename "$repo_url" .git)"
  log_info "Registering Git repository '${repo_url}' in Argo CD"

  if ! apply_gitops_repository_secret "$context" "$repo_name" "$repo_url" \
    "$auth_type" "$username" "$password" "$ssh_private_key"
  then
    log_error "Could not register the Git repository in Argo CD"
    return 1
  fi

  log_info "Creating/updating Argo Application '${app_name}' for path '${app_path}'"
  if ! kubectl --context "$context" -n argocd apply -f - <<EOF
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${app_name}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: "${repo_url}"
    targetRevision: "${branch}"
    path: "${app_path}"
  destination:
    server: https://kubernetes.default.svc
    namespace: ${app_namespace}
  syncPolicy:
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
EOF
  then
    log_error "Could not create Argo Application '${app_name}'"
    return 1
  fi

  log_info "GitOps configured in cluster '${cluster_name}'"
  log_info "Application '${app_name}' tracks path '${app_path}' on branch '${branch}'"
  log_info "Automated sync is enabled with prune=false, so Argo updates existing objects but does not delete them"
  log_info "Inspect applications with: kubectl --context ${context} -n argocd get applications"
  log_info "Open the UI with: kubectl --context ${context} -n argocd port-forward svc/argocd-server 8080:443"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  source_common
  configure_gitops
fi
