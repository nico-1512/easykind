#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/common"
source "$SCRIPT_DIR/install_binaries"
source "$SCRIPT_DIR/create_cluster"
source "$SCRIPT_DIR/install_calico"
source "$SCRIPT_DIR/kube_vip"
source "$SCRIPT_DIR/install_envoy_gateway"
source "$SCRIPT_DIR/install_argocd"
source "$SCRIPT_DIR/configure_gitops"
source "$SCRIPT_DIR/install_etcdctl"
source "$SCRIPT_DIR/upgrade_cluster"
source "$SCRIPT_DIR/delete_cluster"
source "$SCRIPT_DIR/cleanup"

if command -v go >/dev/null 2>&1; then
  export PATH="$(go env GOPATH)/bin:${PATH}"
fi

case "${1:-}" in
  --install-envoy-gateway)
    if (( $# != 1 )); then
      log_error "Usage: main --install-envoy-gateway"
      exit 2
    fi
    install_envoy_gateway || {
      log_error "Envoy Gateway installation failed"
      exit 1
    }
    exit 0
    ;;
  "")
    if (( $# != 0 )); then
      log_error "Usage: main [--install-envoy-gateway]"
      exit 2
    fi
    ;;
  *)
    log_error "Unknown option: $1"
    log_info "Usage: main [--install-envoy-gateway]"
    exit 2
    ;;
esac

if ! command -v gum >/dev/null 2>&1; then
  log_error "gum is required but not installed. See https://github.com/charmbracelet/gum"
  exit 1
fi

gum style --foreground 212 --border double --padding "1 2" --margin "1" \
  "EasyKind

Run the cluster bootstrap steps first. Install Envoy Gateway with: main --install-envoy-gateway
Alternatively, manage it from GitOps. Use only one method for the Envoy Gateway release.
Other platform add-ons can be managed from the GitOps repo.

Run the scripts in this order:
  1. Install binaries
  2. Create cluster
  3. Install Calico
  4. Install kube-vip
  5. Install Argo CD
  6. Configure GitOps
  7. Install etcdctl/etcdutl
  8. Upgrade cluster"

while true; do
  choice=$(gum choose --height 20 --header "What do you want to do?" \
    "1. Install binaries" \
    "2. Create cluster" \
    "3. Install Calico" \
    "4. Install kube-vip" \
    "5. Install Argo CD" \
    "6. Configure GitOps" \
    "7. Install etcdctl/etcdutl" \
    "8. Upgrade cluster" \
    "9. Delete cluster" \
    "10. Cleanup" \
    "11. Exit")

  case "$choice" in
    "1. Install binaries")
      install_binaries || log_error "Binary installation failed"
      ;;
    "2. Create cluster")
      create_cluster || log_error "Cluster creation failed"
      ;;
    "3. Install Calico")
      install_calico || log_error "Calico installation failed"
      ;;
    "4. Install kube-vip")
      install_kube_vip || log_error "kube-vip installation failed"
      ;;
    "5. Install Argo CD")
      install_argocd || log_error "Argo CD installation failed"
      ;;
    "6. Configure GitOps")
      configure_gitops || log_error "GitOps configuration failed"
      ;;
    "7. Install etcdctl/etcdutl")
      install_etcdutl || log_error "etcdctl/etcdutl installation failed"
      ;;
    "8. Upgrade cluster")
      upgrade_cluster || log_error "Cluster upgrade failed"
      ;;
    "9. Delete cluster")
      delete_cluster || log_error "Cluster deletion failed"
      ;;
    "10. Cleanup")
      cleanup_scripts_folder || log_error "Cleanup failed"
      ;;
    "11. Exit"|"")
      log_info "Goodbye"
      break
      ;;
    *)
      log_warning "Unknown option: $choice"
      ;;
  esac
done
