#!/bin/bash
set -euo pipefail

source_common () {
  source "$(dirname "${BASH_SOURCE[0]}")/common"
}

install_argocd () {
  local cluster_name context releases argocd_version namespace manifest_url

  cluster_name=$(request_user_input "Enter the kind cluster name: ")

  if ! kind get clusters 2>/dev/null | grep -qx "$cluster_name"; then
    log_error "Kind cluster '${cluster_name}' not found"
    return 1
  fi

  context="kind-${cluster_name}"
  namespace="argocd"

  releases="$(curl -fsSL https://api.github.com/repos/argoproj/argo-cd/releases/latest)"
  if [[ "$releases" =~ \"tag_name\":[[:space:]]*\"([^\"]+)\" ]]; then
    argocd_version="${BASH_REMATCH[1]}"
  else
    log_error "Could not determine the latest Argo CD version"
    return 1
  fi
  argocd_version="${ARGOCD_VERSION:-$argocd_version}"
  argocd_version=$(request_version "Enter the Argo CD version" "${argocd_version}")

  if [[ "$argocd_version" =~ ^[0-9] ]]; then
    argocd_version="v${argocd_version}"
  fi

  manifest_url="https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/install.yaml"

  log_info "Installing Argo CD ${argocd_version} in cluster '${cluster_name}'"

  if ! kubectl --context "$context" create namespace "$namespace" \
    --dry-run=client -o yaml | kubectl --context "$context" apply -f -; then
    log_error "Could not create namespace '${namespace}'"
    return 1
  fi

  if ! kubectl --context "$context" apply --server-side --force-conflicts \
    -n "$namespace" -f "$manifest_url"; then
    log_error "Could not apply the Argo CD manifest for ${argocd_version}"
    return 1
  fi

  log_info "Waiting for Argo CD to become ready"
  if ! kubectl --context "$context" -n "$namespace" wait \
    --for=condition=Available deployment --all --timeout=300s; then
    log_error "Argo CD deployments did not become Available"
    return 1
  fi
  if ! kubectl --context "$context" -n "$namespace" rollout status \
    statefulset/argocd-application-controller --timeout=300s; then
    log_error "Argo CD application controller did not finish rolling out"
    return 1
  fi

  log_info "Argo CD installed in cluster '${cluster_name}'"
  log_info "Access the UI with: kubectl --context ${context} -n ${namespace} port-forward svc/argocd-server 8080:443"
  log_info "Open https://localhost:8080 and log in as 'admin'"
  log_info "Initial password: kubectl --context ${context} -n ${namespace} get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  source_common
  install_argocd
fi
